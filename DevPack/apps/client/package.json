{
  "name": "@stopthatguy/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --conditions=stopthatguy-source --test src/input/keyboard/*.test.ts src/ui/lobby/*.test.ts src/camera/*.test.ts",
    "test:browser": "tsx --test src/input/keyboard/browser/keyboard.browser.test.ts && tsx --test src/ui/lobby/browser/lobby.browser.test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.37.0",
    "@colyseus/sdk": "0.18.10",
    "@stopthatguy/shared": "0.0.0",
    "@babylonjs/loaders": "9.37.0",
    "babylonjs-gltf2interface": "9.37.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
